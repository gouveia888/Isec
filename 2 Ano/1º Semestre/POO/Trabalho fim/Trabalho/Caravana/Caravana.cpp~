// Encontra caravana pelo ID
Caravana* Caravana::encontrarCaravanaPorId(int id) {
    for (Caravana* c : todasAsCaravanas) {
        if (c->getId() == id) {
            return c; // Retorna a caravana se o ID corresponder
        }
    }
    return nullptr; // Retorna nullptr se não encontrar
}


