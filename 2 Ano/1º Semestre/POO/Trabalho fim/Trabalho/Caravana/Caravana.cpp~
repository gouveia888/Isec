// Inicializa o ID da próxima caravana
int Caravana::proximoId = 1;
std::vector<Caravana*> Caravana::todasAsCaravanas; // Inicializa o vetor estático

Caravana::Caravana() : id(proximoId++), x(0), y(0), mercadoria(0), agua(0), tripulacao(0) {
    todasAsCaravanas.push_back(this); // Adiciona a nova caravana ao vetor
}

Caravana::Caravana(int mercadoria, int agua, int tripulacao, int x, int y)
        : id(proximoId++), mercadoria(mercadoria), agua(agua), tripulacao(tripulacao), x(x), y(y) {
    todasAsCaravanas.push_back(this); // Adiciona a nova caravana ao vetor
}

