void Caravana::ativarAutoGestao() {
    autoGestao = true;
}

void Caravana::desativarAutoGestao() {
    autoGestao = false;
}

bool Caravana::isAutoGestao() const {
    return autoGestao;
}


void Caravana::mover(const std::string& direcao, Buffer& buffer, const Dados& dados) {
    if (isAutoGestao()==true) {
        std::cout << "Caravana " << id << " esta em modo automatico e nao pode ser movida manualmente." << std::endl;
        return; // Impede o movimento se estiver em modo automático
    }

    int xAntigo = x;
    int yAntigo = y;

    // Mapeia a direção para as coordenadas
    if (direcao == "D") { // Direita
        x += 1;
    } else if (direcao == "E") { // Esquerda
        x -= 1;
    } else if (direcao == "C") { // Cima
        y -= 1;
    } else if (direcao == "B") { // Baixo
        y += 1;
    } else if (direcao == "CE") { // Cima-Esquerda
        x -= 1;
        y -= 1;
    } else if (direcao == "CD") { // Cima-Direita
        x += 1;
        y -= 1;
    } else if (direcao == "BE") { // Baixo-Esquerda
        x -= 1;
        y += 1;
    } else if (direcao == "BD") { // Baixo-Direita
        x += 1;
        y += 1;
    }

    // Verifica se a nova posição é válida
    if (buffer.posicaoValida(x, y)) {
        setPosicao(x, y); // Atualiza a posição da caravana
        buffer.atualizarPosicaoCaravana(id, x, y,false); // Atualiza o mapa no buffer
        std::cout << "Caravana " << id << " movida para a posicao (" << x << ", " << y << ")." << std::endl;

        // Chama o metodo de verificação de consumo de água
        verificarConsumoAgua();
    } else {
        // Se a nova posição não for válida, restaura a posição antiga
        x = xAntigo;
        y = yAntigo;
        std::cout << "Movimento invalido! A nova posicao esta fora dos limites ou ocupada." << std::endl;
    }
}

void Caravana::mina() {
    todasAsCaravanas.erase(
            remove(todasAsCaravanas.begin(), todasAsCaravanas.end(), this), //iterador para o inicio do vetor
            todasAsCaravanas.end());
}