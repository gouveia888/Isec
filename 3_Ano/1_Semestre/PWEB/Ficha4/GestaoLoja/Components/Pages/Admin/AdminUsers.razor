@page "/admin/users"

@using Microsoft.AspNetCore.Identity
@using GestaoLoja.Data

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

<h3>Gestao de Utilizadores</h3>

@if(users == null)
{
  <p>A carregar Utilizadores</p>
}
else
{
    <div class="row bg-dark text-white">
        <div class="col-2">Username</div>
        <div class="col-2">Nome</div>
        <div class="col-2">Apelido</div>
        <div class="col-1">NIF</div>
        <div class="col-5">Roles</div>
    </div>
    @foreach (var user in users)
    {
        <div class="row">
            <div class="col-2">@user.Email</div>
            <div class="col-2">@user.Nome</div>
            <div class="col-2">@user.Apelido</div>
            <div class="col-1">@user.NIF</div>
            <div class="col-5">
                @if (usersWithRoles.ContainsKey(user.Id))
                {
                    @foreach (var role in usersWithRoles[user.Id])
                    {
                        <span>@role</span>
                        <input type="button" value="x" class="btn btn-danger bt-sm ml-2" @onclick="()=>RemoveRole(user.Id, role)"/>
                        <input type="button" value="+" class="btn btn-success bt-sm ml-2" />
                    }
                }

            </div>
        </div>
    }
}

@code {

    List<ApplicationUser>? users;

	Dictionary<string, List<string>> usersWithRoles = new(); //cada user pode ter mais que uma role dai List<string>
    List<IdentityRole>? roles;
    bool alt = false;

    protected async Task RemoveRole(string userId, string roleName)
    {
        var user = await UserManager.FindByIdAsync(userId);

        if(user != null)
        {
            var result = await UserManager.RemoveFromRoleAsync(user, roleName); //como esta a passar o roleName???
            if(result.Succeeded)
            {
				usersWithRoles[userId].Remove(roleName);
				StateHasChanged();
                //await CarregarDados();
            }
        }
	}

    protected async Task CarregarDados()
    {
        users = UserManager.Users.ToList();

        foreach(var user in users)
        {
            var userRoles = await UserManager.GetRolesAsync(user);
			//usersWithRoles[user.Id] = userRoles.ToList();
			usersWithRoles.Add(user.Id, userRoles.ToList());
		}

		roles = RoleManager.Roles.ToList();
	}

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized(); //Sistema de inicializacao base
        await CarregarDados(); //Carregar dados iniciais
    }

}
